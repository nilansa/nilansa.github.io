{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nilansa.github.io/cs-conf/hub/paper.schema.v2.json",
  "title": "CS Conference Hub normalized paper record v2 (design contract)",
  "description": "Future ingestion contract. Existing 2022–2026 shards remain v1; do not imply automatic compliance or verified enrichment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_uid",
    "title",
    "authors",
    "venue",
    "year",
    "publication_type",
    "identifiers",
    "links",
    "facets",
    "provenance"
  ],
  "properties": {
    "paper_uid": {
      "type": "string",
      "pattern": "^paper:[0-9a-f]{24}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "orcid": {
            "type": [
              "string",
              "null"
            ]
          },
          "openalex_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "venue_alias": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": "integer",
      "minimum": 1980,
      "maximum": 2100
    },
    "publication_type": {
      "type": "string",
      "enum": [
        "main",
        "findings",
        "workshop",
        "demo",
        "industry",
        "journal",
        "preprint",
        "other",
        "unverified"
      ]
    },
    "track": {
      "type": [
        "string",
        "null"
      ]
    },
    "track_verification": {
      "type": "string",
      "enum": [
        "official",
        "source_claim",
        "unverified"
      ]
    },
    "abstract": {
      "type": [
        "string",
        "null"
      ]
    },
    "abstract_rights": {
      "type": "string",
      "enum": [
        "redistributable",
        "link_only",
        "unknown"
      ]
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "DOI, dblp key, OpenReview ID, ACL Anthology ID, CVF ID, arXiv ID, etc."
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "description": "Official landing, lawful PDF, code, dataset, supplementary material"
    },
    "facets": {
      "type": "object",
      "required": [
        "task",
        "method",
        "domain",
        "dataset",
        "evaluation",
        "application"
      ],
      "additionalProperties": false,
      "properties": {
        "task": {
          "$ref": "#/$defs/facet_array"
        },
        "method": {
          "$ref": "#/$defs/facet_array"
        },
        "domain": {
          "$ref": "#/$defs/facet_array"
        },
        "dataset": {
          "$ref": "#/$defs/facet_array"
        },
        "evaluation": {
          "$ref": "#/$defs/facet_array"
        },
        "application": {
          "$ref": "#/$defs/facet_array"
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "cites",
              "cited_by",
              "related",
              "uses_dataset",
              "extends",
              "contradicts_claim"
            ]
          },
          "target": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "primary_source",
        "retrieved_at",
        "source_rights",
        "source_record_id"
      ],
      "properties": {
        "primary_source": {
          "type": "string"
        },
        "source_record_id": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_rights": {
          "type": "string",
          "enum": [
            "cc0",
            "cc-by",
            "mit-metadata",
            "restricted",
            "unknown"
          ]
        },
        "enrichments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "time",
              "fields"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "time": {
                "type": "string",
                "format": "date-time"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "facet_array": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "origin",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "enum": [
              "publisher",
              "dataset",
              "human",
              "model"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
